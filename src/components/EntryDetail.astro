---
/*
 * Shared template for a work page and a project page:
 * title, description, then every photo stacked with its caption.
 */
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Photo from './Photo.astro';
import { ARTIST, type Entry } from '../lib/content';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { title, year, material, dimensions, images } = entry.data;
const { Content } = await render(entry);
const grid = 'layout' in entry.data && entry.data.layout === 'grid';

// "<b>ARTIST</b>, <i>TITLE</i>, MATERIAL, YEAR, DIMENSIONS. <caption>"
const details = [material, year, dimensions]
  .filter((v) => v !== undefined && v !== '')
  // Non-breaking hyphens keep words like "C-print" on one line.
  .map((v) => String(v).replace(/-/g, '\u2011'));
---

<article class:list={['detail', grid && 'detail--grid']}>
  <h1 class="detail__title">{title}</h1>
  <div class="detail__text">
    <Content />
  </div>

  {
    grid && images.length > 0 && (
      <ul class="series">
        {images.map((image, i) => (
          <li class="series__item">
            <Picture
              src={image.src}
              alt={image.alt ?? image.title ?? `${title}, ${i + 1} of ${images.length}`}
              widths={[360, 540, 720, 1080].filter((w) => w <= image.src.width).concat(image.src.width < 360 ? [image.src.width] : [])}
              sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 1024px) calc((100vw - 112px) / 2), min(calc((100vw - 144px) / 3), 360px)"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
              class="series__img"
            />
            {(image.title || image.year) && (
              <p class="series__label">
                {image.title && <span class="series__title">{image.title}</span>}
                {image.year && <span class="series__year">{image.year}</span>}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {
    !grid && images.length > 0 && (
      <div class="detail__photos">
        {images.map((image, i) => (
          <figure class="detail__figure">
            <Photo
              src={image.src}
              alt={image.alt ?? `${title}, photograph ${i + 1} of ${images.length}`}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <figcaption class="caption">
              <b>{ARTIST}</b>, <i>{title}</i>
              {details.map((d) => `, ${d}`)}.{image.caption && ` ${image.caption}`}
            </figcaption>
          </figure>
        ))}
      </div>
    )
  }
</article>
