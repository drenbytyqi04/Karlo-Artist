---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" current="search">
  <div class="search">
    <h1 class="visually-hidden">Search</h1>
    <form class="search__form" role="search" action="/search/" method="get">
      <label for="q" class="visually-hidden">Search works, projects and texts</label>
      <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Search" />
    </form>
    <p class="search__status" id="search-status" aria-live="polite"></p>
    <ul class="rows search__results" id="search-results"></ul>
  </div>
</BaseLayout>

<script>
  type Item = { type: string; title: string; year: string | number; url: string; text: string };

  const input = document.querySelector<HTMLInputElement>('#q')!;
  const form = input.form!;
  const list = document.querySelector<HTMLUListElement>('#search-results')!;
  const status = document.querySelector<HTMLParagraphElement>('#search-status')!;

  let index: Item[] | null = null;
  const load = async () => (index ??= await fetch('/search.json').then((r) => r.json()));

  const normalize = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '');

  function excerpt(text: string, term: string) {
    const at = normalize(text).indexOf(term);
    if (at < 0) return text.slice(0, 160) + (text.length > 160 ? '…' : '');
    const start = Math.max(0, at - 60);
    return (start > 0 ? '…' : '') + text.slice(start, start + 180) + (start + 180 < text.length ? '…' : '');
  }

  async function run() {
    const query = input.value.trim();
    const url = new URL(location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);

    list.replaceChildren();
    if (!query) {
      status.textContent = '';
      return;
    }

    const terms = normalize(query).split(/\s+/).filter(Boolean);
    const items = await load();
    const results = items
      .map((item) => {
        const title = normalize(item.title);
        const body = normalize(`${item.year} ${item.text}`);
        if (!terms.every((t) => title.includes(t) || body.includes(t))) return null;
        const score = terms.reduce((s, t) => s + (title.includes(t) ? 10 : 0) + (body.includes(t) ? 1 : 0), 0);
        return { item, score };
      })
      .filter((r): r is { item: Item; score: number } => r !== null)
      .sort((a, b) => b.score - a.score);

    status.textContent = results.length === 1 ? '1 result' : `${results.length} results`;

    for (const { item } of results) {
      const li = document.createElement('li');
      li.className = 'row result';
      const a = document.createElement('a');
      a.href = item.url;
      a.className = 'result__title';
      a.textContent = item.title;
      const meta = document.createElement('span');
      meta.className = 'result__meta';
      meta.textContent = [item.type, item.year].filter(Boolean).join(' · ');
      const p = document.createElement('p');
      p.className = 'result__excerpt';
      p.textContent = excerpt(item.text, terms[0]);
      li.append(a, meta, p);
      list.append(li);
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    run();
  });
  input.addEventListener('input', run);

  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    run();
  }
</script>
