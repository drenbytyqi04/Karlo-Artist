---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Thumb from '../../components/Thumb.astro';
import { getWorks } from '../../lib/content';

const works = await getWorks();
---

<BaseLayout title="Works" current="works">
  <h1 class="visually-hidden">Works</h1>
  <ul class="grid">
    {
      works.map((work, i) => (
        <li>
          <a href={`/works/${work.id}/`} class="card">
            <Thumb src={work.data.images[0]?.src} loading={i < 3 ? 'eager' : 'lazy'} />
            <span class="card__line">
              <span class="card__title">{work.data.title}</span>
              {work.data.year !== undefined && <span class="card__year">{work.data.year}</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
