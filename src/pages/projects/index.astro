---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Thumb from '../../components/Thumb.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<BaseLayout title="Projects" current="projects">
  <h1 class="visually-hidden">Projects</h1>
  <ul class="grid">
    {
      projects.map((project, i) => (
        <li>
          <a href={`/projects/${project.id}/`} class="card">
            <Thumb src={project.data.images[0]?.src} loading={i < 3 ? 'eager' : 'lazy'} />
            <h2 class="card__project-title">{project.data.title}</h2>
            {project.data.meta && <p class="card__meta">{project.data.meta}</p>}
            {project.data.summary && <p class="card__summary">{project.data.summary}</p>}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
