---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" current="contact">
  <h1 class="visually-hidden">Contact</h1>
  <dl class="rows contact">
    <div class="row">
      <dt>Email</dt>
      <dd>[EMAIL]</dd>
    </div>
    <div class="row">
      <dt>Phone</dt>
      <dd>[PHONE]</dd>
    </div>
    <div class="row">
      <dt>Studio</dt>
      <dd>Prishtina, Kosovo</dd>
    </div>
    <div class="row">
      <dt>Instagram</dt>
      <dd>[@HANDLE]</dd>
    </div>
  </dl>
</BaseLayout>
